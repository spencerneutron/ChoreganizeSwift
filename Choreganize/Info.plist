<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Required to receive CloudKit share invitations: without this key, tapping
	     a Household share link tells the recipient to update the app (the system
	     assumes the installed version can't accept shares) and the acceptance is
	     never delivered. -->
	<key>CKSharingSupported</key>
	<true/>
	<!-- Snap a Room (#105): the camera is used only when the user takes a photo of a
	     room; the photo is analyzed on-device and never saved. -->
	<key>NSCameraUsageDescription</key>
	<string>Take a photo of a room to get chore ideas for it. Photos are analyzed on this device and aren’t saved.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<!-- CG-20 / #102: automatic scheduled backups run as a BGProcessingTask. -->
		<string>processing</string>
	</array>
	<!-- CG-20 / #102: identifiers BGTaskScheduler will accept for this app —
	     must match AutoBackup.taskIdentifier or registration throws at launch. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.svk.Choreganize.autobackup</string>
	</array>
	<!-- CG-20 / #102: expose Documents (where Backups/ lives) in the Files app so
	     users can see and retrieve automatic backups without the app's UI. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Spoken alias so Siri App Shortcut phrases like "my Chores today" resolve
	     to the app (in addition to the primary name "Choreganize"). -->
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Chores</string>
		</dict>
	</array>
	<!-- Widget deep-linking (CG-05): `choreganize://chore/<uuid>` / `choreganize://today`.
	     Built by the widget (WidgetDeepLink) and handled in ChoreganizeApp.onOpenURL. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.svk.Choreganize.widget</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>choreganize</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
