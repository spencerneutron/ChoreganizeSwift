<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Required to receive CloudKit share invitations: without this key, tapping
	     a Household share link tells the recipient to update the app (the system
	     assumes the installed version can't accept shares) and the acceptance is
	     never delivered. -->
	<key>CKSharingSupported</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Spoken alias so Siri App Shortcut phrases like "my Chores today" resolve
	     to the app (in addition to the primary name "Choreganize"). -->
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Chores</string>
		</dict>
	</array>
	<!-- Widget deep-linking (CG-05): `choreganize://chore/<uuid>` / `choreganize://today`.
	     Built by the widget (WidgetDeepLink) and handled in ChoreganizeApp.onOpenURL. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.svk.Choreganize.widget</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>choreganize</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
