{
  "note": "sRGB hex. Blend amber/lavender in OKLab or SwiftUI .perceptual, never plain sRGB. Sources: Choreganize/CompletionWash.swift, Choreganize/SectionRim.swift, Assets.xcassets/AccentColor, tools/wash-lab/playground.html.",
  "brand": {
    "amber": "#FFC233",
    "lavender": "#AEB4FF",
    "honey": "#FFD978"
  },
  "wash": {
    "colorA": "#FFC233",
    "colorB": "#AEB4FF",
    "glow": "#FFD978",
    "duration_s": 8.0,
    "look": 1,
    "motion": 1,
    "strength": {
      "ios": 1.0,
      "mac": 0.55
    },
    "iteration": "06-night-haze"
  },
  "sectionRim": {
    "light": {
      "stroke": "#FFD978",
      "halo": "#FFD978"
    },
    "dark": {
      "stroke": "#AEB4FF",
      "halo": "#AEB4FF"
    },
    "hairline_pt": 1.4,
    "flourishStroke_pt": 1.6,
    "restStrokeOpacity": {
      "min": 0.25,
      "max": 0.6
    },
    "haloOpacity": {
      "rest_at_100pct": 0.14,
      "flourish_peak": 0.4
    },
    "haloFalloff": "half-Gaussian from the edge, outside only; demo = 3 pt stroke blurred sigma 6 and sigma 18",
    "easing_s": 0.22,
    "cardCornerRadius_pt": {
      "iOS26+": 25,
      "before": 10
    }
  },
  "toggles": {
    "style": "system switch, .tint(.accentColor)",
    "light": {
      "on": "#7370CF"
    },
    "dark": {
      "on": "#8285DF"
    },
    "off": "system (no API)",
    "thumb": "#FFFFFF",
    "contrastThumbVsOn": {
      "light": 4.2,
      "dark": 3.3
    },
    "rejected": {
      "PromiseToggleStyle": {
        "light": {
          "off": "#E8DFC8",
          "on": "#7370CF"
        },
        "dark": {
          "off": "#433D31",
          "on": "#8285DF"
        }
      }
    }
  },
  "page": {
    "light": {
      "grouped": "#F2F2F7",
      "card": "#FFFFFF"
    },
    "dark": {
      "grouped": "#000000",
      "card": "#1C1C1E"
    }
  },
  "accent": {
    "light": "#7370CF",
    "dark": "#8285DF",
    "lightHighContrast": "#4B48AE",
    "darkHighContrast": "#8285DF",
    "mac": "applies under the Multicolor system accent only"
  }
}
