{
  "note": "sRGB hex. Blend amber/lavender in OKLab or SwiftUI .perceptual, never plain sRGB. Sources: Choreganize/CompletionWash.swift, Choreganize/PromiseToggleStyle.swift, tools/wash-lab/playground.html.",
  "brand": {
    "amber": "#FFC233",
    "lavender": "#AEB4FF",
    "honey": "#FFD978"
  },
  "wash": {
    "colorA": "#FFC233",
    "colorB": "#AEB4FF",
    "glow": "#FFD978",
    "duration_s": 8.0,
    "look": 1,
    "motion": 1,
    "strength": { "ios": 1.0, "mac": 0.55 },
    "iteration": "06-night-haze"
  },
  "sectionRim": {
    "light": { "stroke": "#FFD978", "halo": "#FFD978" },
    "dark": { "stroke": "#AEB4FF", "halo": "#AEB4FF" },
    "hairline_pt": 1.4,
    "flourishStroke_pt": 1.6,
    "restStrokeOpacity": { "min": 0.25, "max": 0.60 },
    "haloOpacity": { "rest_at_100pct": 0.14, "flourish_peak": 0.40 },
    "haloFalloff": "half-Gaussian from the edge, outside only; demo = 3 pt stroke blurred sigma 6 and sigma 18",
    "easing_s": 0.22
  },
  "toggles": {
    "light": { "off": "#E8DFC8", "on": "#7370CF" },
    "dark": { "off": "#433D31", "on": "#8285DF" },
    "thumb": "#FFFFFF",
    "contrastThumbVsOn": { "light": 4.1, "dark": 3.5 }
  },
  "page": {
    "light": { "grouped": "#F2F2F7", "card": "#FFFFFF" },
    "dark": { "grouped": "#000000", "card": "#1C1C1E" }
  }
}
